# Only the app's group can create virtual input devices or access these calculators.
SUBSYSTEM=="usb", ATTR{idVendor}=="0451", ATTR{idProduct}=="e022", MODE="0660", GROUP="ndmirror"
SUBSYSTEM=="usb", ATTR{idVendor}=="0451", ATTR{idProduct}=="e012", MODE="0660", GROUP="ndmirror"
SUBSYSTEM=="misc", KERNEL=="uinput", MODE="0660", GROUP="ndmirror", OPTIONS+="static_node=uinput"
